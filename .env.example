# Local development — DEBUG must be True for runserver convenience
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production (Render) uses SECRET_KEY / DEBUG / ALLOWED_HOSTS instead; both work.
# SECRET_KEY=
# DEBUG=false
# ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
DATABASE_URL=
SITE_NAME=InfoPlex  # ignored; brand is hardcoded in settings
BRAND_MARK=I
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@infoplex.local
BKASH_ACCOUNT_NUMBER=01XXXXXXXXX
BKASH_ACCOUNT_NAME=InfoPlex
